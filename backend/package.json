{
  "name": "@bloom/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=.env src/server.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "build": "tsup src/server.ts --format esm --target node20 --out-dir dist --clean --external sharp --external pg",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/db/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bloom/shared": "*",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@electric-sql/pglite-socket": "^0.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
