# Copy to backend/.env (or keep using the repo-root .env).
# Local dev: `npm run db:dev -w backend` starts a real Postgres on 6544 (this URL is the default).
DATABASE_URL=postgresql://postgres:bloom@127.0.0.1:6544/bloom
PORT=8787
PUBLIC_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
# The Bloom guide (agent). Without keys it uses its rule-based planner.
GROQ_API_KEY=
OPENROUTER_KEY=
AGENT_MODEL=openai/gpt-oss-120b
# Unit circuit breaker
BUDGET_TOTAL=600
BUDGET_SESSION=60
